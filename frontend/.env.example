# Copy to .env.local and fill in real values. Never commit the real file.

# Secret NextAuth uses to sign session cookies/JWTs. Generate with:
#   openssl rand -hex 32
NEXTAUTH_SECRET=

# Canonical URL of this frontend deployment (used for OAuth callback construction).
NEXTAUTH_URL=http://localhost:3000

# FastAPI backend base URL, used server-side by NextAuth and by the
# next.config.mjs /api/v1/:path* rewrite. Not exposed to the browser.
BACKEND_URL=http://127.0.0.1:8000

# Google OAuth 2.0 credentials (same Client ID as backend/.env.example's
# GOOGLE_CLIENT_ID). Add the authorized redirect URI in Google Cloud Console:
#   ${NEXTAUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
