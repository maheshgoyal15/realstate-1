# Copy to .env and fill in real values. Never commit the real .env file.

# Postgres connection string (see docker-compose.yml for local dev credentials)
DATABASE_URL=postgresql://homeready_app:CHANGE_ME@127.0.0.1:5432/homeready_dev

# Redis connection string (used for rate limiting / Celery broker)
REDIS_URL=redis://:CHANGE_ME@127.0.0.1:6379/0

# Symmetric secret used to sign/verify backend-issued JWTs.
# Must match the value NextAuth signs cookies with is NOT required - this is the
# backend's own access-token secret, independent of NEXTAUTH_SECRET.
JWT_SECRET_KEY=

# Google OAuth 2.0 Client ID (same value as GOOGLE_CLIENT_ID in frontend/.env.example).
# Used to verify the audience of Google-issued ID tokens server-side.
GOOGLE_CLIENT_ID=
